{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palm-portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-30",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/views", "/api/views/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VIEW_COUNTERS",
        "class_name": "ViewCounter",
      },
    ],
  },
  "exports": {
    "ViewCounter": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "routes": [
    {
      "pattern": "palmcat.dev",
      "custom_domain": true,
    },
  ],
}
