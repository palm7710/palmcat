{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palm-portfolio",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "palmcat.dev",
      "custom_domain": true,
    },
  ],
}
